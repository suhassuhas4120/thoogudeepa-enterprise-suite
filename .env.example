#   cp .env.example .env.local
# Add these exact keys to your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Required — Free Tier)
# ------------------------------------------------------------------------------
# Available from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://dwjjprzyyjmunhdxvkuo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_n2WMU-LLYOgykukVbxg5Zw_vHCa74DV
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_n2WMU-LLYOgykukVbxg5Zw_vHCa74DV
# (Optional) Service Role Secret for server-side admin operations:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------------------------------------------------------------------
# 2. APPLICATION BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3001
# In Production: https://thoogudeepa.vercel.app or https://thoogudeepa.in

# ------------------------------------------------------------------------------
# 3. RAZORPAY UPI & CARD PAYMENTS (Free Setup — 2% per txn)
# ------------------------------------------------------------------------------
# Available from: https://dashboard.razorpay.com -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ------------------------------------------------------------------------------
# 4. DIGITAL BILLS & RECEIPT EMAILS (Resend — 3,000 free/mo)
# ------------------------------------------------------------------------------
# Available from: https://resend.com -> API Keys
RESEND_API_KEY=re_placeholder_key
RECEIPT_FROM_EMAIL=receipts@thoogudeepa.in

# ------------------------------------------------------------------------------
# 5. WHATSAPP BILL DELIVERY (Meta Cloud API — 1,000 free conversations/mo)
# ------------------------------------------------------------------------------
# Available from: https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=placeholder_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_id

# ------------------------------------------------------------------------------
# 6. ERROR MONITORING (Sentry — 5,000 free events/mo)
# ------------------------------------------------------------------------------
# Available from: https://sentry.io -> Project Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 7. ANALYTICS & REPLAYS (PostHog — 1M free events/mo)
# ------------------------------------------------------------------------------
# Available from: https://us.posthog.com or https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------------------
# 8. HIGH-RUSH REDIS CACHE & RATE LIMITING (Upstash — 10k free req/day)
# ------------------------------------------------------------------------------
# Available from: https://console.upstash.com -> Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
