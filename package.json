    "generate-qrs": "node scripts/generate-qr-assets.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.103.2",
    "@types/qrcode": "^1.5.6",
